            "parameters": {
                "jsCode": "const { execSync } = require('child_process');\nconst files = [\n  '/data/workspace/banle/docs/FEATURES.md',\n  '/data/workspace/banle/docs/PORTAL_NAVIGATION.md',\n  '/data/workspace/banle/docs/REQUIREMENTS.md',\n  '/data/workspace/banle/docs/USE_CASES.md',\n  '/data/workspace/banle/docs/DATABASE_ARCHITECTURE.md'\n];\n\nlet combinedContent = '';\nfor (const file of files) {\n  try {\n    const content = execSync(`node /data/tools/fs/read_file.js ${file}`).toString();\n    combinedContent += `\\n\\n--- FILE: ${file} ---\\n${content}`;\n  } catch (err) {\n    console.error(`Error reading ${file}:`, err.message);\n  }\n}\n\nreturn { combined_docs: combinedContent };"
            },
            "name": "Code: Read All Docs",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                600,
                300
            ]
        },
