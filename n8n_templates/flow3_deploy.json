{
    "name": "Flow 3: Local Deployment",
    "active": true,
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "deploy-local",
                "options": {}
            },
            "name": "Webhook: Start Deploy",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                400,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const { execSync } = require('child_process');\nconst logs = [];\n\ntry {\n  logs.push({ step: 'Migration', result: execSync('npx prisma migrate dev', { cwd: '/data/workspace/banle' }).toString() });\n  logs.push({ step: 'Build', result: execSync('npm install && npm run build', { cwd: '/data/workspace/banle' }).toString() });\n  // Using '&' to run in background if it's a dev server, but for build we want it to finish.\n  // npm run dev usually hangs, so we might need a different strategy for restart.\n} catch (e) {\n  logs.push({ step: 'Error', result: e.message });\n}\n\nreturn { logs };"
            },
            "name": "Code: Deploy Steps",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                800,
                300
            ]
        },
        {
            "parameters": {
                "model": "qwen3-coder:480b-cloud",
                "options": {
                    "systemPrompt": "You are DevOps. Review the logs and confirm if the local deployment was successful."
                }
            },
            "name": "AI: Deploy Verification",
            "type": "n8n-nodes-base.ollama",
            "typeVersion": 1,
            "position": [
                1000,
                300
            ]
        }
    ],
    "connections": {
        "Webhook: Start Deploy": {
            "main": [
                [
                    {
                        "node": "Code: Deploy Steps",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Code: Deploy Steps": {
            "main": [
                [
                    {
                        "node": "AI: Deploy Verification",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}